{% doc %}
  @prompt
    制作一个Explore 导航区 ,导航条，多个按钮，可以做成按钮形式 ：20 Ply
    25 Ply
    30 Ply
    40 Ply
    Color Chart
    Custom Order, Heading
    
    Explore More Feather Boa Options
    
    Text
    
    Need more volume or a custom color match? Compare fuller feather boa styles, view our color chart, or request a custom order.
    
    Links
    
    20 Ply Feather Boas
    25 Ply Feather Boas
    30 Ply Feather Boas
    40 Ply Feather Boas
    Ostrich Feather Color Chart
    Custom Feather Boa Order
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-explore-nav-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-explore-nav-container-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-explore-nav-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    text-align: {{ block.settings.title_alignment }};
    {% if block.settings.title_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-explore-nav-description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 {{ block.settings.description_spacing }}px 0;
    text-align: {{ block.settings.title_alignment }};
    line-height: 1.5;
  }

  .ai-explore-nav-buttons-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.button_gap }}px;
    justify-content: {{ block.settings.button_alignment }};
  }

  .ai-explore-nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    display: inline-block;
    {% if block.settings.button_uppercase %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: {{ block.settings.button_letter_spacing | divided_by: 100.0 }}em;
  }

  .ai-explore-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-explore-nav-buttons-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_button_alignment }};
    }

    .ai-explore-nav-button-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.button_font_size }}px * 0.9);
      padding: {{ block.settings.button_padding_vertical | times: 0.8 }}px {{ block.settings.button_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-explore-nav-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-explore-nav-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h2 class="ai-explore-nav-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-explore-nav-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
    {% endif %}

    <div class="ai-explore-nav-buttons-{{ ai_gen_id }}">
      {% if block.settings.button_1_text != blank %}
        <a href="{{ block.settings.button_1_link }}" class="ai-explore-nav-button-{{ ai_gen_id }}">
          {{ block.settings.button_1_text }}
        </a>
      {% endif %}

      {% if block.settings.button_2_text != blank %}
        <a href="{{ block.settings.button_2_link }}" class="ai-explore-nav-button-{{ ai_gen_id }}">
          {{ block.settings.button_2_text }}
        </a>
      {% endif %}

      {% if block.settings.button_3_text != blank %}
        <a href="{{ block.settings.button_3_link }}" class="ai-explore-nav-button-{{ ai_gen_id }}">
          {{ block.settings.button_3_text }}
        </a>
      {% endif %}

      {% if block.settings.button_4_text != blank %}
        <a href="{{ block.settings.button_4_link }}" class="ai-explore-nav-button-{{ ai_gen_id }}">
          {{ block.settings.button_4_text }}
        </a>
      {% endif %}

      {% if block.settings.button_5_text != blank %}
        <a href="{{ block.settings.button_5_link }}" class="ai-explore-nav-button-{{ ai_gen_id }}">
          {{ block.settings.button_5_text }}
        </a>
      {% endif %}

      {% if block.settings.button_6_text != blank %}
        <a href="{{ block.settings.button_6_link }}" class="ai-explore-nav-button-{{ ai_gen_id }}">
          {{ block.settings.button_6_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

