      "default": true
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Title",
      "default": "Inner Pocket"
    },
    {
      "type": "textarea",
      "id": "text_3",
      "label": "Text",
      "default": "Includes a zipper pocket for keys, cards, or small essentials."
