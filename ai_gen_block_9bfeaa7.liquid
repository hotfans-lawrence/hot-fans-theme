{% doc %}
  @prompt
    Create a clean and elegant Instagram inspiration section for my Shopify homepage.
    
    Brand style: luxury feather fans, ostrich feather boas, burlesque, cabaret, stage performance, custom orders, elegant theatrical styling.
    
    Section goal:
    Add a small Instagram-style gallery near the bottom of the homepage, above the footer. The section should inspire visitors and encourage them to follow us on Instagram, but it should not distract from shopping or custom orders.
    
    Layout:
    - Place this section after Best Sellers / Custom Orders / Reviews, and before the footer.
    - Use a clean 4-image grid on desktop.
    - Use 2 columns on mobile.
    - Keep the design elegant, lightweight, and premium.
    - Images should be square 1:1 ratio.
    - Add one button linking to our Instagram profile.
    
    Title:
    Feather Inspiration on Instagram
    
    Subtitle:
    Follow us for feather fan colors, luxury boa styling, custom order ideas, and stage-ready looks.
    
    Button text:
    Follow Us on Instagram
    
    Design style:
    - White or soft neutral background
    - Elegant spacing
    - Minimal text
    - Luxury fashion / performance mood
    - Do not make the section too large
    - Do not place it at the top of the homepage
    - Keep it clean and conversion-friendly
    
    Important:
    This Instagram section should support the brand image, not replace product shopping. The main homepage focus should remain Featured Collections, Best Sellers, and Custom Orders.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instagram-section-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
    display: block;
  }

  .ai-instagram-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-instagram-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-instagram-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    font-weight: {{ block.settings.title_weight }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-instagram-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    opacity: 0.85;
    line-height: 1.6;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-instagram-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.button_spacing }}px;
  }

  .ai-instagram-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-instagram-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .ai-instagram-item-{{ ai_gen_id }}:hover .ai-instagram-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-instagram-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-instagram-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-instagram-button-wrapper-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-instagram-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-instagram-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-instagram-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  @media screen and (max-width: 989px) {
    .ai-instagram-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-instagram-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-instagram-subtitle-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtitle_size }}px * 0.9);
    }

    .ai-instagram-section-{{ ai_gen_id }} {
      padding: calc({{ block.settings.section_padding }}px * 0.7) 15px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-instagram-button-{{ ai_gen_id }} {
      padding: {{ block.settings.button_padding_vertical | times: 0.9 }}px {{ block.settings.button_padding_horizontal | times: 0.9 }}px;
      font-size: calc({{ block.settings.button_font_size }}px * 0.95);
    }
  }
{% endstyle %}

<div class="ai-instagram-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-instagram-container-{{ ai_gen_id }}">
    <div class="ai-instagram-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-instagram-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-instagram-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="ai-instagram-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% assign image_key = 'image_' | append: i %}
        {% assign image = block.settings[image_key] %}
        
        <div class="ai-instagram-item-{{ ai_gen_id }}">
          {% if image != blank %}
            <img
              src="{{ image | image_url: width: 600 }}"
              alt="{{ image.alt | escape }}"
              loading="lazy"
              width="600"
              height="600"
              class="ai-instagram-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-instagram-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.button_text != blank and block.settings.instagram_url != blank %}
      <div class="ai-instagram-button-wrapper-{{ ai_gen_id }}">
        <a 
          href="{{ block.settings.instagram_url }}" 
          class="ai-instagram-button-{{ ai_gen_id }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="ai-instagram-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span>{{ block.settings.button_text }}</span>
        </a>
      </div>
    {% endif %}
  </div>
</div>

