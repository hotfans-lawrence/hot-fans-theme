{% doc %}
  @prompt
    Text with Icons
    
    可以放 4 个 icon：
    
    Holds 1–2 Fans
    Designed for carrying one or two feather fans.
    
    Travel Friendly
    Great for rehearsals, performances, photoshoots, and travel.
    
    Inner Pocket
    Includes a zipper pocket for keys, cards, or small essentials.
    
    Three Sizes Available
    Choose the best size for your feather fans.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-text-icons-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-text-icons-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-text-icons-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: {{ block.settings.layout }};
    align-items: {{ block.settings.alignment }};
    text-align: {{ block.settings.text_align }};
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-text-icons-icon-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
  }

  .ai-text-icons-icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-text-icons-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-text-icons-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-text-icons-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-text-icons-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }
{% endstyle %}

<div class="ai-text-icons-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-text-icons-grid-{{ ai_gen_id }}">
    {% if block.settings.show_item_1 %}
      <div class="ai-text-icons-item-{{ ai_gen_id }}">
        <div class="ai-text-icons-icon-wrapper-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="ai-text-icons-content-{{ ai_gen_id }}">
          {% if block.settings.title_1 != blank %}
            <h3 class="ai-text-icons-title-{{ ai_gen_id }}">{{ block.settings.title_1 }}</h3>
          {% endif %}
          {% if block.settings.text_1 != blank %}
            <div class="ai-text-icons-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_item_2 %}
      <div class="ai-text-icons-item-{{ ai_gen_id }}">
        <div class="ai-text-icons-icon-wrapper-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <div class="ai-text-icons-content-{{ ai_gen_id }}">
          {% if block.settings.title_2 != blank %}
            <h3 class="ai-text-icons-title-{{ ai_gen_id }}">{{ block.settings.title_2 }}</h3>
          {% endif %}
          {% if block.settings.text_2 != blank %}
            <div class="ai-text-icons-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_item_3 %}
      <div class="ai-text-icons-item-{{ ai_gen_id }}">
        <div class="ai-text-icons-icon-wrapper-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="9" y1="3" x2="9" y2="21"></line>
          </svg>
        </div>
        <div class="ai-text-icons-content-{{ ai_gen_id }}">
          {% if block.settings.title_3 != blank %}
            <h3 class="ai-text-icons-title-{{ ai_gen_id }}">{{ block.settings.title_3 }}</h3>
          {% endif %}
          {% if block.settings.text_3 != blank %}
            <div class="ai-text-icons-text-{{ ai_gen_id }}">{{ block.settings.text_3 }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.show_item_4 %}
      <div class="ai-text-icons-item-{{ ai_gen_id }}">
        <div class="ai-text-icons-icon-wrapper-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <div class="ai-text-icons-content-{{ ai_gen_id }}">
          {% if block.settings.title_4 != blank %}
            <h3 class="ai-text-icons-title-{{ ai_gen_id }}">{{ block.settings.title_4 }}</h3>
          {% endif %}
          {% if block.settings.text_4 != blank %}
            <div class="ai-text-icons-text-{{ ai_gen_id }}">{{ block.settings.text_4 }}</div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
