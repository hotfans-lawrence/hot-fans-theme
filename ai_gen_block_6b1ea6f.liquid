{% doc %}
  @prompt
    Table
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow-x: auto;
    display: block;
  }

  .ai-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-table-{{ ai_gen_id }} thead {
    background-color: {{ block.settings.header_background }};
  }

  .ai-table-{{ ai_gen_id }} th {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.header_alignment }};
    color: {{ block.settings.header_text_color }};
    font-weight: 600;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    font-size: {{ block.settings.header_font_size }}px;
  }

  .ai-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.cell_alignment }};
    color: {{ block.settings.cell_text_color }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    font-size: {{ block.settings.cell_font_size }}px;
  }

  .ai-table-{{ ai_gen_id }} tbody tr:nth-child(even) {
    background-color: {{ block.settings.row_alternate_background }};
  }

  .ai-table-{{ ai_gen_id }} tbody tr:hover {
    background-color: {{ block.settings.row_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-table-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-table-{{ ai_gen_id }} th,
    .ai-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      font-size: {{ block.settings.cell_font_size | times: 0.9 }}px;
    }

    .ai-table-{{ ai_gen_id }} th {
      font-size: {{ block.settings.header_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-table-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <table class="ai-table-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <thead>
        <tr>
          {% if block.settings.header_col_1 != blank %}
            <th>{{ block.settings.header_col_1 }}</th>
          {% endif %}
          {% if block.settings.header_col_2 != blank %}
            <th>{{ block.settings.header_col_2 }}</th>
          {% endif %}
          {% if block.settings.header_col_3 != blank %}
            <th>{{ block.settings.header_col_3 }}</th>
          {% endif %}
          {% if block.settings.header_col_4 != blank %}
            <th>{{ block.settings.header_col_4 }}</th>
          {% endif %}
        </tr>
      </thead>
    {% endif %}
    <tbody>
      {% for i in (1..10) %}
        {% liquid
          assign row_key = 'row_' | append: i
          assign col1_key = row_key | append: '_col_1'
          assign col2_key = row_key | append: '_col_2'
          assign col3_key = row_key | append: '_col_3'
          assign col4_key = row_key | append: '_col_4'
          
          assign col1_value = block.settings[col1_key]
          assign col2_value = block.settings[col2_key]
          assign col3_value = block.settings[col3_key]
          assign col4_value = block.settings[col4_key]
          
          assign has_content = false
          if col1_value != blank or col2_value != blank or col3_value != blank or col4_value != blank
            assign has_content = true
          endif
        %}
        
        {% if has_content %}
          <tr>
            {% if block.settings.header_col_1 != blank %}
              <td>{{ col1_value }}</td>
            {% endif %}
            {% if block.settings.header_col_2 != blank %}
              <td>{{ col2_value }}</td>
            {% endif %}
            {% if block.settings.header_col_3 != blank %}
              <td>{{ col3_value }}</td>
            {% endif %}
            {% if block.settings.header_col_4 != blank %}
              <td>{{ col4_value }}</td>
            {% endif %}
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>
</div>

