{% doc %}
  @prompt
    制作一个适合场景区块
    标题：
    
    Best For
    
    四个小卡片：
    
    Parties & Events
    Lightweight and fun for birthdays, themed parties, celebrations, and glamorous event outfits.
    
    Costumes & Cosplay
    A simple way to add feather texture and vintage-inspired style to costumes and character looks.
    
    Beginner Burlesque
    A comfortable option for beginners who want a soft feather look without too much weight or volume.
    
    Photography Styling
    Adds movement, softness, and color to portraits, fashion shoots, bridal shoots, and creative photography.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-best-for-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-best-for-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    font-weight: 600;
  }

  .ai-best-for-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin: 0;
  }

  .ai-best-for-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-best-for-card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }
  {% endif %}

  .ai-best-for-card-title-{{ ai_gen_id }} {
    color: {{ block.settings.card_title_color }};
    font-size: {{ block.settings.card_title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
  }

  .ai-best-for-card-text-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    font-size: {{ block.settings.card_text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-best-for-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-best-for-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-best-for-card-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_title_size }}px * 0.9);
    }

    .ai-best-for-card-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.card_text_size }}px * 0.95);
    }
  }
{% endstyle %}

<best-for-section-{{ ai_gen_id }} class="ai-best-for-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-best-for-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-best-for-grid-{{ ai_gen_id }}">
    {% if block.settings.card_1_title != blank %}
      <div class="ai-best-for-card-{{ ai_gen_id }}">
        <h3 class="ai-best-for-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h3>
        {% if block.settings.card_1_text != blank %}
          <div class="ai-best-for-card-text-{{ ai_gen_id }}">{{ block.settings.card_1_text }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.card_2_title != blank %}
      <div class="ai-best-for-card-{{ ai_gen_id }}">
        <h3 class="ai-best-for-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h3>
        {% if block.settings.card_2_text != blank %}
          <div class="ai-best-for-card-text-{{ ai_gen_id }}">{{ block.settings.card_2_text }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.card_3_title != blank %}
      <div class="ai-best-for-card-{{ ai_gen_id }}">
        <h3 class="ai-best-for-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h3>
        {% if block.settings.card_3_text != blank %}
          <div class="ai-best-for-card-text-{{ ai_gen_id }}">{{ block.settings.card_3_text }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.card_4_title != blank %}
      <div class="ai-best-for-card-{{ ai_gen_id }}">
        <h3 class="ai-best-for-card-title-{{ ai_gen_id }}">{{ block.settings.card_4_title }}</h3>
        {% if block.settings.card_4_text != blank %}
          <div class="ai-best-for-card-text-{{ ai_gen_id }}">{{ block.settings.card_4_text }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</best-for-section-{{ ai_gen_id }}>

