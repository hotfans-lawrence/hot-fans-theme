{% doc %}
  @prompt
    featured shops ,但Layout
    Columns on desktop 数量为最大为8, 没有了Card background
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-shops-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-featured-shops-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-featured-shops-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-featured-shops-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
  }

  .ai-featured-shops-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-featured-shops-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-featured-shop-card-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-featured-shop-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-featured-shop-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-featured-shop-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-featured-shop-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-shop-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-featured-shop-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-shop-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
  }

  .ai-featured-shop-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.shop_name_size }}px;
    color: {{ block.settings.shop_name_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-featured-shop-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.shop_description_size }}px;
    color: {{ block.settings.shop_description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-shops-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-featured-shops-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-shops-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-featured-shops-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }

    .ai-featured-shop-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<featured-shops-{{ ai_gen_id }} class="ai-featured-shops-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-shops-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-featured-shops-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-featured-shops-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-featured-shops-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-featured-shops-grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign shop_name_key = 'shop_' | append: i | append: '_name'
          assign shop_description_key = 'shop_' | append: i | append: '_description'
          assign shop_image_key = 'shop_' | append: i | append: '_image'
          assign shop_url_key = 'shop_' | append: i | append: '_url'

          assign shop_name = block.settings[shop_name_key]
          assign shop_description = block.settings[shop_description_key]
          assign shop_image = block.settings[shop_image_key]
          assign shop_url = block.settings[shop_url_key]
        %}

        {% if shop_name != blank %}
          <div class="ai-featured-shop-card-{{ ai_gen_id }}">
            {% if shop_url != blank %}
              <a href="{{ shop_url }}" class="ai-featured-shop-link-{{ ai_gen_id }}">
            {% endif %}

            <div class="ai-featured-shop-image-wrapper-{{ ai_gen_id }}">
              {% if shop_image %}
                <img
                  src="{{ shop_image | image_url: width: 600 }}"
                  alt="{{ shop_name | escape }}"
                  class="ai-featured-shop-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-featured-shop-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-featured-shop-content-{{ ai_gen_id }}">
              <h3 class="ai-featured-shop-name-{{ ai_gen_id }}">{{ shop_name }}</h3>
              {% if shop_description != blank %}
                <p class="ai-featured-shop-description-{{ ai_gen_id }}">{{ shop_description }}</p>
              {% endif %}
            </div>

            {% if shop_url != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</featured-shops-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedShops{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeAccessibility();
      }

      initializeAccessibility() {
        const cards = this.querySelectorAll('.ai-featured-shop-card-{{ ai_gen_id }}');
        cards.forEach(card => {
          const link = card.querySelector('.ai-featured-shop-link-{{ ai_gen_id }}');
          if (link) {
            link.setAttribute('tabindex', '0');
          }
        });
      }
    }

    customElements.define('featured-shops-{{ ai_gen_id }}', FeaturedShops{{ ai_gen_id }});
  })();
</script>

